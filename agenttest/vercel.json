{
  "version": 2,
  "builds": [
    {
      "src": "api/config.js",
      "use": "@vercel/edge"
    },
    {
      "src": "api/generate.js",
      "use": "@vercel/edge"
    },
    {
      "src": "api/query.js",
      "use": "@vercel/edge"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/generate",
      "dest": "/api/generate.js"
    },
    {
      "src": "/api/query",
      "dest": "/api/query.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}